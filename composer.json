{
    "name": "timmcleod/agent-workflows-ui",
    "description": "A read-only dashboard for timmcleod/agent-workflows: watch runs as live flowcharts with step status, interrupts, failures, and token usage.",
    "keywords": ["laravel", "ai", "agents", "workflows", "dashboard", "ui", "monitoring", "observability", "read-only"],
    "license": "MIT",
    "authors": [
        {
            "name": "Tim McLeod",
            "email": "tim@timmcleod.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "timmcleod/agent-workflows": "^0.9|^0.10|^0.11|^0.12|^0.13|^0.14|^0.15"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../agent-workflows",
            "options": {"symlink": true}
        }
    ],
    "autoload": {
        "psr-4": {
            "TimMcLeod\\AgentWorkflowsUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TimMcLeod\\AgentWorkflowsUi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        },
        "laravel": {
            "providers": [
                "TimMcLeod\\AgentWorkflowsUi\\AgentWorkflowsUiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
